{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "title": "BytePet",
        "label": "main",
        "width": 1280,
        "height": 800,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "shadow": false,
        "skipTaskbar": true,
        "visibleOnAllWorkspaces": true
      }
    ]
  },
  "bundle": {
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.icns", "icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/512x512.png"],
    "macOS": {
      "minimumSystemVersion": "13.3",
      "signingIdentity": "-",
      "infoPlist": "Info.macos.plist"
    }
  }
}
